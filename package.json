{
  "name": "starter-nestjs",
  "version": "1.0.0",
  "description": "NestJS API starter with persisted sessions, explicit pagination, PostgreSQL migrations and verified container tooling",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint src test --max-warnings=0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "lint-staged",
    "test:integration": "jest --config ./test/jest-postgres.json --runInBand",
    "db:show": "node -r ts-node/register -r tsconfig-paths/register src/database/cli.ts show",
    "db:show:prod": "node dist/database/cli.js show",
    "db:migrate": "node -r ts-node/register -r tsconfig-paths/register src/database/cli.ts migrate",
    "db:migrate:prod": "node dist/database/cli.js migrate",
    "db:revert": "node -r ts-node/register -r tsconfig-paths/register src/database/cli.ts revert",
    "db:revert:prod": "node dist/database/cli.js revert",
    "db:baseline": "node -r ts-node/register -r tsconfig-paths/register src/database/cli.ts baseline",
    "db:baseline:prod": "node dist/database/cli.js baseline",
    "db:seed": "node -r ts-node/register -r tsconfig-paths/register src/database/cli.ts seed",
    "db:seed:prod": "node dist/database/cli.js seed",
    "db:seed:admin": "node -r ts-node/register -r tsconfig-paths/register src/database/cli.ts seed-admin",
    "db:seed:admin:prod": "node dist/database/cli.js seed-admin",
    "db:generate": "node -r ts-node/register -r tsconfig-paths/register node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "lint:fix": "pnpm lint --fix",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/common": "^11.2.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "cache-manager": "^6.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "joi": "^17.13.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22.22.3 <23",
    "pnpm": "11.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kayange123/nestjs-starter.git"
  },
  "bugs": {
    "url": "https://github.com/Kayange123/nestjs-starter/issues"
  },
  "homepage": "https://github.com/Kayange123/nestjs-starter#readme"
}
