# Application Settings
APP_NAME=NestJS API Starter Kit
APP_DESCRIPTION=A comprehensive NestJS API with authentication, RBAC, and more
NODE_ENV=development
PORT=3030

# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nestjs_starter
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public
DB_SYNC=false
DB_LOGGING=false

# Cache Settings
CACHE_TTL=300

# Security Settings
JWT_SECRET=
# Set JWT_SECRET to a random value of at least 32 characters.
JWT_ACCESS_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=604800
JWT_ISSUER=nestjs-starter
JWT_AUDIENCE=nestjs-api
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=5
BODY_LIMIT_BYTES=65536
SWAGGER_ENABLED=true
HEALTH_TIMEOUT_MS=1000

# Throttling and Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Logging Configuration
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# File Storage
FILE_STORAGE_PATH=./uploads
MAX_FILE_SIZE=10485760

# Optional bootstrap administrator: used only by db:seed:admin.
# Supply credentials through your environment; there is no default administrator.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
